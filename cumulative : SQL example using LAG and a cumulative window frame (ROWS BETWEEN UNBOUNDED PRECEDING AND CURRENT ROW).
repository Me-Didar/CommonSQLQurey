SELECT
    Id,
    SalesDate,
    SalesAmount,
    LAG(SalesAmount, 1) OVER (ORDER BY SalesDate) AS PreviousDaySales,
    SUM(SalesAmount) OVER (
        ORDER BY SalesDate
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS RunningTotal
FROM Sales;

